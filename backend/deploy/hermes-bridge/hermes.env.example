# /etc/ahlan/hermes.env   (owner root, group ahlan-hermes, mode 0640)
# One shared, NON-secret file read by three units: ahlan-hermes-bridge, ahlan-api, ahlan-worker.
# Secrets (DATABASE_URL, HERMES_API_KEY ...) stay where they are today (the app's own .env); the bridge never sees them.

# --- bridge ---------------------------------------------------------------------------------------------
# The one and only container the bridge will touch. Requests cannot choose another.
HERMES_CONTAINER=hermes-ahlan
HERMES_BRIDGE_SOCKET_MODE=0660
# Second lock: only these UIDs may call the bridge (SO_PEERCRED). Fill with:  id -u chatbot-pesantren
HERMES_BRIDGE_ALLOWED_UIDS=__UID_OF_CHATBOT_PESANTREN__

# --- API and worker -------------------------------------------------------------------------------------
HERMES_EXEC_MODE=bridge
HERMES_BRIDGE_SOCKET=/run/ahlan-hermes/bridge.sock

# --- callback (Hermes container -> API) -----------------------------------------------------------------
# Do NOT assume 172.17.0.1. Run  deploy/hermes-bridge/detect-events-addr.sh  and paste ITS output here: it reads the
# real gateway of the network hermes-ahlan is attached to. The URL is also the bridge's allow-list for log hooks.
HERMES_EVENTS_LISTEN=__GATEWAY_IP__:8081
HERMES_EVENTS_URL=http://__GATEWAY_IP__:8081/api/v1/internal/hermes/events

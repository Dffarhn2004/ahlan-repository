# Local development
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres-local-only@localhost:5432/chatbot_pesantren_db?sslmode=disable
DATA_ROOT=./data
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=admin-local-only

# Frontend runs separately on port 3000
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Shared secret for Hermes -> API Telegram event hooks
HERMES_API_KEY=replace-with-a-local-secret

# --- Hermes runtime access -------------------------------------------------------------------------------
# docker = call the local Docker CLI (development; the default unless APP_ENV=production).
# bridge = talk to the privileged bridge over a Unix socket (production; the default when APP_ENV=production).
# HERMES_EXEC_MODE=docker
# HERMES_CONTAINER=deploy-hermes-1
# HERMES_EXEC_MODE=bridge
# HERMES_BRIDGE_SOCKET=/run/ahlan-hermes/bridge.sock
# Where the Hermes container posts conversation events. It must be reachable from INSIDE the container.
# HERMES_EVENTS_URL=http://host.docker.internal:8080/api/v1/internal/hermes/events
# Production (Linux): extra listener on the container network gateway that serves only the events route.
# HERMES_EVENTS_LISTEN=<docker network gateway>:8081   (deploy/hermes-bridge/detect-events-addr.sh prints it)
